{
  "name": "vnyan-mcp",
  "version": "0.3.0",
  "description": "MCP server for full-coverage control of VNyan (VTuber avatar software) - parameters, triggers, blendshapes, bones, pendulums, props, colliders, node graphs, and more.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seth-rah/vnyan-mcp.git"
  },
  "keywords": ["mcp", "model-context-protocol", "vnyan", "vtuber", "claude"],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vnyan-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p . && node -e \"require('fs').cpSync('src/graph/schema.json','dist/graph/schema.json')\"",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.7.3"
  }
}
